NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
# Phase 32: include the storefront's origin in CORS_ORIGINS. Optional: <slug>.<STOREFRONT_BASE_DOMAIN> resolves to a store.
# STOREFRONT_BASE_DOMAIN=shops.example.com
DATABASE_URL=postgresql://pulseops:pulseops@localhost:5432/pulseops?schema=public
REDIS_URL=redis://localhost:6379
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Leave unset in production so unavailable PostgreSQL/Redis stops startup. Set false for local degraded-mode development.
FAIL_ON_DEPENDENCY_ERROR=false
# JWT secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
# Phase 34: signs storage download URLs; must differ from the JWT secrets. Required in production.
STORAGE_SIGNING_SECRET=your-storage-signing-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
PASSWORD_RESET_EXPIRY=1h
EMAIL_VERIFICATION_EXPIRY=24h
PAYMENT_WEBHOOK_SECRET=your-webhook-secret-min-32-chars-change-in-prod
PAYMENT_PROVIDER=mock
# Phase 35: encrypts each shop's Razorpay secrets in the database (required in production to connect Razorpay;
# min 32 chars, not the JWT secret). Shops enter their own Razorpay keys in workspace settings, not here.
# CREDENTIALS_ENCRYPTION_KEY=your-credentials-encryption-key-min-32-chars
# Email over SMTP (unset = log-only mock). Brevo: smtp://login%40smtp-brevo.com:xsmtpsib-KEY@smtp-relay.brevo.com:587
# Gmail (app password): smtps://name%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
# SMTP_URL=
# EMAIL_FROM=PulseOps <no-reply@example.com>
# Staff web app; verification / password-reset links point here (default: first CORS origin)
# APP_URL=http://localhost:5173
# Phase 36: reports (and their files) are deleted after this many days; 0 keeps them
# REPORT_RETENTION_DAYS=30
# Recurring jobs (nightly cleanup, scheduled reports); default on, except NODE_ENV=test
# JOB_SCHEDULERS_ENABLED=true
# Phase 36: RS256 access tokens (default HS256). PEM with \n escapes; old public keys stay valid while rotating.
# Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# JWT_ALGORITHM=RS256
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PREVIOUS_PUBLIC_KEYS=
# Refresh-token cookie mode (clients opt in with X-Refresh-Token-Transport: cookie)
# REFRESH_COOKIE_SAMESITE=strict
# REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_DOMAIN=
# Storage (local for dev, s3 for production)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
LOCAL_STORAGE_URL=/storage
# S3 (required when STORAGE_PROVIDER=s3)
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_PUBLIC_BASE_URL=https://your-public-url
# Rate limiting (tune per environment; auth is stricter)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=100
# CORS must be explicitly set in production (no wildcard with credentials)
# CORS_ORIGINS=https://app.example.com# Platform admin created by `npm run db:seed`. Required (12+ chars, upper/lower/digit/symbol) whenever
# NODE_ENV is not development/test; in development the seed falls back to a local default account.
# PLATFORM_ADMIN_EMAIL=platform-admin@example.com
# PLATFORM_ADMIN_PASSWORD=change-me-Strong#Passphrase1
