model Order {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId      String       @map("customer_id")
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status          OrderStatus  @default(DRAFT)
  subtotal        Decimal      @db.Decimal(12, 2)
  discountTotal   Decimal      @default(0) @db.Decimal(12, 2) @map("discount_total")
  taxTotal        Decimal      @default(0) @db.Decimal(12, 2) @map("tax_total")
  shippingTotal   Decimal      @default(0) @db.Decimal(12, 2) @map("shipping_total")
  total           Decimal      @db.Decimal(12, 2)
  currency        String       @default("INR")
  metadata        Json         @default("{}")
  shippingAddress Json?        @map("shipping_address")
  billingAddress  Json?        @map("billing_address")
  // Phase 38: the tax invoice
  invoiceNumber   String?      @map("invoice_number")
  invoiceDate     DateTime?    @db.Timestamptz(6) @map("invoice_date")
  placeOfSupply   String?      @db.VarChar(2) @map("place_of_supply")
  supplyType      String?      @map("supply_type")
  cgstTotal       Decimal      @default(0) @db.Decimal(12, 2) @map("cgst_total")
  sgstTotal       Decimal      @default(0) @db.Decimal(12, 2) @map("sgst_total")
  igstTotal       Decimal      @default(0) @db.Decimal(12, 2) @map("igst_total")
  buyerSnapshot   Json?        @map("buyer_snapshot")
  sellerSnapshot  Json?        @map("seller_snapshot")
  // Phase 39: STAFF (back office), STOREFRONT (online shop) or POS (counter sale)
  channel         String       @default("STAFF")
  createdAt       DateTime     @db.Timestamptz(6) @default(now()) @map("created_at")
  updatedAt       DateTime     @db.Timestamptz(6) @updatedAt @map("updated_at")
  deletedAt       DateTime?    @db.Timestamptz(6) @map("deleted_at")

  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  payments        Payment[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, customerId, createdAt])
  @@unique([tenantId, invoiceNumber])
  @@map("orders")
}

