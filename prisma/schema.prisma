  userAgent     String?      @map("user_agent")
  createdAt     DateTime     @db.Timestamptz(6) @default(now()) @map("created_at")

  @@index([tenantId, userId, createdAt])
  @@index([tenantId, resource, resourceId])
  @@index([tenantId, action, createdAt])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model ActivityLog {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  description String?
  metadata    Json     @default("{}")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @db.Timestamptz(6) @default(now()) @map("created_at")

  @@index([tenantId, userId, createdAt])
  @@index([tenantId, action, createdAt])
  @@index([tenantId, createdAt])
  @@map("activity_logs")
}

// Phase 38: running invoice number per workspace per Indian financial year (e.g. "2026-27")
model InvoiceSequence {
  tenantId      String   @map("tenant_id")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  financialYear String   @db.VarChar(7) @map("financial_year")
  lastNumber    Int      @default(0) @map("last_number")
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@id([tenantId, financialYear])
  @@map("invoice_sequences")
}

// Phase 39: a counter (till) and its shifts. One open shift per counter (partial unique index in SQL).
model CashRegister {
  id        String        @id @default(uuid())
  tenantId  String        @map("tenant_id")
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime      @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")
  sessions  CashSession[]

  @@unique([tenantId, name])
  @@map("cash_registers")
}

model CashSession {
  id           String         @id @default(uuid())
  tenantId     String         @map("tenant_id")
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registerId   String         @map("register_id")
  register     CashRegister   @relation(fields: [registerId], references: [id], onDelete: Cascade)
  // OPEN or CLOSED
  status       String         @default("OPEN")
  openingFloat Decimal        @default(0) @db.Decimal(12, 2) @map("opening_float")
  expectedCash Decimal?       @db.Decimal(12, 2) @map("expected_cash")
  countedCash  Decimal?       @db.Decimal(12, 2) @map("counted_cash")
  variance     Decimal?       @db.Decimal(12, 2)
  openedBy     String?        @map("opened_by")
  openedAt     DateTime       @default(now()) @db.Timestamptz(6) @map("opened_at")
  closedBy     String?        @map("closed_by")
  closedAt     DateTime?      @db.Timestamptz(6) @map("closed_at")
  note         String?
  movements    CashMovement[]

  @@index([tenantId, registerId, openedAt])
  @@map("cash_sessions")
}

model CashMovement {
  id        String      @id @default(uuid())
  tenantId  String      @map("tenant_id")
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId String      @map("session_id")
  session   CashSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // SALE, REFUND, CASH_IN or CASH_OUT; amount is always positive
  type      String
  amount    Decimal     @db.Decimal(12, 2)
  reason    String?
  orderId   String?     @map("order_id")
  paymentId String?     @map("payment_id")
  createdBy String?     @map("created_by")
  createdAt DateTime    @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([tenantId, sessionId])
  @@map("cash_movements")
}

// Phase 39: a cart parked at the counter
model PosHeldSale {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?  @map("user_id")
  label     String?
  cart      Json
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("pos_held_sales")
}

// Phase 39: replay store for Idempotency-Key (scope = tenant or store)
model IdempotencyKey {
  scopeId     String   @map("scope_id")
  key         String   @db.VarChar(255)
  route       String
  requestHash String   @map("request_hash")
  statusCode  Int?     @map("status_code")
  response    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@id([scopeId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}
