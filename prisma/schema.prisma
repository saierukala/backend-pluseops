generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TenantMembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
  ARCHIVED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum AttributeDataType {
  TEXT
  NUMBER
  BOOLEAN
  OPTION
}

enum InventoryMovementType {
  ADJUSTMENT
  TRANSFER
  ORDER_RESERVATION
  ORDER_RELEASE
  ORDER_FULFILLMENT
  RETURN
  DAMAGED
  LOST
  COUNT
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PaymentTransactionType {
  CHARGE
  REFUND
  CAPTURE
  VOID
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
}

enum AddressType {
  SHIPPING
  BILLING
}

enum ReportType {
  ORDERS
  INVENTORY
  CUSTOMERS
}

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum ReportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CustomerTokenType {
  SET_PASSWORD
}

enum TokenType {
  REFRESH
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  status    TenantStatus @default(TRIAL)
  plan      String   @default("free")
  createdAt DateTime @db.Timestamptz(6) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(6) @updatedAt @map("updated_at")

  settings              TenantSettings?
  domains               TenantDomain[]
  paymentGateway        TenantPaymentGateway?
  supportSessions       SupportSession[]
  reports               Report[]
  reportSchedules       ReportSchedule[]
  platformAuditLogs     PlatformAuditLog[]
  customerSessions      CustomerSession[]
  customerTokens        CustomerToken[]
  cartItems             CartItem[]
  users                 User[]
  memberships           TenantMembership[]
  roles                 Role[]
  permissions           Permission[]
  userRoles             UserRole[]
  rolePermissions       RolePermission[]
  products              Product[]
  categories            Category[]
  productCategories     ProductCategory[]
  productVariants       ProductVariant[]
  productVariantAttributes ProductVariantAttribute[]
  productImages         ProductImage[]
  attributeDefinitions  AttributeDefinition[]
  attributeValues       AttributeValue[]
  warehouses            Warehouse[]
  inventory             Inventory[]
  inventoryMovements    InventoryMovement[]
  warehouseInventory    WarehouseInventory[]
  customers             Customer[]
  customerAddresses     CustomerAddress[]
  orders                Order[]
  orderItems            OrderItem[]
  orderStatusHistory    OrderStatusHistory[]
  payments              Payment[]
  paymentTransactions   PaymentTransaction[]
  refunds               Refund[]
  paymentWebhookEvents  PaymentWebhookEvent[]
  notifications         Notification[]
  notificationPreferences NotificationPreference[]
  notificationTemplates NotificationTemplate[]
  auditLogs             AuditLog[]
  activityLogs          ActivityLog[]
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  invoiceSequences      InvoiceSequence[]
  cashRegisters         CashRegister[]
  cashSessions          CashSession[]
  cashMovements         CashMovement[]
  posHeldSales          PosHeldSale[]

  @@map("tenants")
}

model TenantSettings {
  id        String   @id @default(uuid())
  tenantId  String   @unique @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metadata  Json     @default("{}")
  createdAt DateTime @db.Timestamptz(6) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(6) @updatedAt @map("updated_at")

  @@map("tenant_settings")
}

// Phase 35: the shop's own Razorpay account; money goes straight to it. Secrets are encrypted (secret-box.js).
model TenantPaymentGateway {
  id                     String   @id @default(uuid())
  tenantId               String   @unique @map("tenant_id")
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider               String   @default("razorpay")
  keyId                  String   @map("key_id")
  keySecretEncrypted     String   @map("key_secret_encrypted")
  webhookSecretEncrypted String?  @map("webhook_secret_encrypted")
  enabled                Boolean  @default(true)
  createdAt              DateTime @db.Timestamptz(6) @default(now()) @map("created_at")
  updatedAt              DateTime @db.Timestamptz(6) @updatedAt @map("updated_at")

  @@map("tenant_payment_gateways")
}

model TenantDomain {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domain    String
  verified  Boolean  @default(false)
  primary   Boolean  @default(false)
  // Phase 32: DNS TXT value expected at _pulseops-verify.<domain>
  verificationToken String?   @map("verification_token")
  verifiedAt        DateTime? @db.Timestamptz(6) @map("verified_at")
  createdAt DateTime @db.Timestamptz(6) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(6) @updatedAt @map("updated_at")

  // Several tenants may claim an unverified domain; only one may hold it verified (partial unique index
  // "tenant_domains_domain_verified_key", migration 20261024_phase32_storefront). At most one primary per
  // tenant: "tenant_domains_tenant_id_primary_key" (migration 20261024_phase30_tenant_workspace).
  @@unique([tenantId, domain])
  @@index([domain])
  @@map("tenant_domains")
}

// CSV export generated by the report worker (Phase 31). The file lives in tenant storage at storageKey.
model Report {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy String?      @map("requested_by")
  requester   User?        @relation(fields: [requestedBy], references: [id], onDelete: SetNull)
  scheduleId  String?      @map("schedule_id")
  schedule    ReportSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  type        ReportType
  format      String       @default("csv")
  status      ReportStatus @default(PENDING)
  filters     Json         @default("{}")
  storageKey  String?      @map("storage_key")
  rowCount    Int?         @map("row_count")
  sizeBytes   Int?         @map("size_bytes")
  error       String?
  startedAt   DateTime?    @db.Timestamptz(6) @map("started_at")
  completedAt DateTime?    @db.Timestamptz(6) @map("completed_at")
  createdAt   DateTime     @db.Timestamptz(6) @default(now()) @map("created_at")
  updatedAt   DateTime     @db.Timestamptz(6) @updatedAt @map("updated_at")

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([createdAt])
  @@map("reports")
}

// Phase 36: a report re-run every day/week/month for the period just ended (UTC); recipients get a link by email.
model ReportSchedule {
  id               String          @id @default(uuid())
  tenantId         String          @map("tenant_id")
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy        String?         @map("created_by")
  creator          User?           @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  name             String
  type             ReportType
  frequency        ReportFrequency
  filters          Json            @default("{}")
  recipientUserIds String[]        @map("recipient_user_ids")
  enabled          Boolean         @default(true)
  lastPeriod       String?         @map("last_period")
  lastRunAt        DateTime?       @db.Timestamptz(6) @map("last_run_at")
  lastReportId     String?         @map("last_report_id")
  lastError        String?         @map("last_error")
  createdAt        DateTime        @db.Timestamptz(6) @default(now()) @map("created_at")
  updatedAt        DateTime        @db.Timestamptz(6) @updatedAt @map("updated_at")

  reports          Report[]

  @@index([tenantId])
  @@index([enabled])
  @@map("report_schedules")
}

// Read-only platform support access to one tenant (Phase 30, frontend F33).
model SupportSession {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platformUserId String    @map("platform_user_id")
  platformUser   User      @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  reason         String
  expiresAt      DateTime  @db.Timestamptz(6) @map("expires_at")
  endedAt        DateTime? @db.Timestamptz(6) @map("ended_at")
  createdAt      DateTime  @db.Timestamptz(6) @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([platformUserId])
  @@map("support_sessions")
}

model User {
  id            String     @id @default(uuid())
  tenantId      String     @map("tenant_id")
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email         String
  passwordHash  String     @map("password_hash")
  firstName     String     @map("first_name")
  lastName      String     @map("last_name")
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false) @map("email_verified")
  lastLoginAt   DateTime?  @db.Timestamptz(6) @map("last_login_at")
  createdAt     DateTime   @db.Timestamptz(6) @default(now()) @map("created_at")
  updatedAt     DateTime   @db.Timestamptz(6) @updatedAt @map("updated_at")
  deletedAt     DateTime?  @db.Timestamptz(6) @map("deleted_at")

  userRoles           UserRole[]
  auditLogs           AuditLog[]
  activityLogs        ActivityLog[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  memberships         TenantMembership[]
  supportSessions     SupportSession[]
  reports             Report[]
  reportSchedules     ReportSchedule[]
  platformAuditLogs   PlatformAuditLog[]
  platformUserRoles   PlatformUserRole[]

  // One person = one account = one business (decided in Phase 30); email is unique platform-wide.
  @@unique([email])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("users")
}

model TenantMembership {
  id        String                 @id @default(uuid())
  tenantId  String                 @map("tenant_id")
  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String                 @map("user_id")
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String?                @map("role_id")
  role      Role?                  @relation(fields: [roleId], references: [id], onDelete: SetNull)
  status    TenantMembershipStatus @default(ACTIVE)
  createdAt DateTime               @db.Timestamptz(6) @default(now()) @map("created_at")
  updatedAt DateTime               @db.Timestamptz(6) @updatedAt @map("updated_at")

  @@unique([tenantId, userId])
  @@index([userId, status])
  @@index([tenantId, status])
  @@map("tenant_memberships")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @map("token_hash")
  expiresAt DateTime @db.Timestamptz(6) @map("expires_at")
  revokedAt DateTime? @db.Timestamptz(6) @map("revoked_at")
  createdAt DateTime @db.Timestamptz(6) @default(now()) @map("created_at")
  // Phase 28: login session carried across rotation (= JWT sessionId); null for legacy rows
  sessionId  String?   @db.Uuid @map("session_id")
  userAgent  String?   @db.VarChar(512) @map("user_agent")
  ipAddress  String?   @db.VarChar(64) @map("ip_address")
  lastUsedAt DateTime? @db.Timestamptz(6) @map("last_used_at")

  @@index([tenantId, userId])
  @@index([tokenHash])
  @@index([sessionId])
  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @map("token_hash")
  expiresAt DateTime @db.Timestamptz(6) @map("expires_at")
  usedAt    DateTime? @db.Timestamptz(6) @map("used_at")
  createdAt DateTime @db.Timestamptz(6) @default(now()) @map("created_at")

  @@index([tenantId, userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @map("token_hash")
  expiresAt DateTime @db.Timestamptz(6) @map("expires_at")
  usedAt    DateTime? @db.Timestamptz(6) @map("used_at")
  createdAt DateTime @db.Timestamptz(6) @default(now()) @map("created_at")

  @@index([tenantId, userId])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @db.Timestamptz(6) @default(now()) @map("created_at")
  updatedAt   DateTime @db.Timestamptz(6) @updatedAt @map("updated_at")

  userRoles        UserRole[]
  memberships      TenantMembership[]
  rolePermissions  RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

// Subscription plan (Phase 33). Tenant.plan holds the code. A null limit means unlimited.
model Plan {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  // { users, products, warehouses, ordersPerMonth } — each an integer or null
  limits      Json     @default("{}")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @db.Timestamptz(6) @default(now()) @map("created_at")
  updatedAt   DateTime @db.Timestamptz(6) @updatedAt @map("updated_at")

  @@map("plans")
}

// What platform admins did (Phase 33). Separate from tenant audit logs, which tenants can read.
model PlatformAuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  tenantId    String?  @map("tenant_id")
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  details     Json     @default("{}")
  ipAddress   String?  @db.VarChar(64) @map("ip_address")
  userAgent   String?  @db.VarChar(512) @map("user_agent")
  createdAt   DateTime @db.Timestamptz(6) @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("platform_audit_logs")
}

model PlatformRole {
  id          String                   @id @default(uuid())
  name        String                   @unique
  description String?
  isSystem    Boolean                  @default(false) @map("is_system")
  createdAt   DateTime                 @db.Timestamptz(6) @default(now()) @map("created_at")
  updatedAt   DateTime                 @db.Timestamptz(6) @updatedAt @map("updated_at")
  userRoles   PlatformUserRole[]
  permissions PlatformRolePermission[]

  @@map("platform_roles")
}

model PlatformPermission {
  id          String                   @id @default(uuid())
  name        String                   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime                 @db.Timestamptz(6) @default(now()) @map("created_at")
  updatedAt   DateTime                 @db.Timestamptz(6) @updatedAt @map("updated_at")
  rolePermissions PlatformRolePermission[]

  @@unique([resource, action])
  @@map("platform_permissions")
}

model PlatformUserRole {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String       @map("role_id")
  role      PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime     @db.Timestamptz(6) @default(now()) @map("created_at")

  @@unique([userId, roleId])
  @@index([userId])
  @@map("platform_user_roles")
}

model PlatformRolePermission {
  id           String             @id @default(uuid())
  roleId       String             @map("role_id")
  role         PlatformRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String             @map("permission_id")
  permission   PlatformPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @db.Timestamptz(6) @default(now()) @map("created_at")

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("platform_role_permissions")
}

model Permission {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  resource    String
  action      String
  createdAt   DateTime @db.Timestamptz(6) @default(now()) @map("created_at")
  updatedAt   DateTime @db.Timestamptz(6) @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@unique([tenantId, resource, action])
  @@index([tenantId])
  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String   @map("role_id")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @db.Timestamptz(6) @default(now()) @map("created_at")

  @@unique([tenantId, userId, roleId])
  @@index([tenantId, userId])
  @@index([tenantId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId        String   @map("role_id")
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId  String   @map("permission_id")
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt     DateTime @db.Timestamptz(6) @default(now()) @map("created_at")

  @@unique([tenantId, roleId, permissionId])
  @@index([tenantId, roleId])
  @@index([tenantId, permissionId])
  @@map("role_permissions")
}

model Category {
  id          String     @id @default(uuid())
  tenantId    String     @map("tenant_id")
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentId    String?    @map("parent_id")
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  name        String
  slug        String
  description String?
  sortOrder   Int        @default(0) @map("sort_order")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @db.Timestamptz(6) @default(now()) @map("created_at")
  updatedAt   DateTime   @db.Timestamptz(6) @updatedAt @map("updated_at")
  deletedAt   DateTime?  @db.Timestamptz(6) @map("deleted_at")

  productCategories ProductCategory[]

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@index([tenantId, parentId])
  @@map("categories")
}

model Product {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  brand         String?
  status        ProductStatus @default(DRAFT)
  basePrice     Decimal?      @db.Decimal(12, 2) @map("base_price")
  // Phase 38: GST classification; gstRatePercent null = the workspace default rate
  hsnCode        String?       @db.VarChar(8) @map("hsn_code")
  gstRatePercent Decimal?      @db.Decimal(5, 2) @map("gst_rate_percent")
  gstTaxability  String        @default("TAXABLE") @map("gst_taxability")
  unit           String?       @db.VarChar(10)
  createdAt     DateTime      @db.Timestamptz(6) @default(now()) @map("created_at")
  updatedAt     DateTime      @db.Timestamptz(6) @updatedAt @map("updated_at")
  deletedAt     DateTime?     @db.Timestamptz(6) @map("deleted_at")

  categories       ProductCategory[]
  variants         ProductVariant[]
  images           ProductImage[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("products")
}

model ProductCategory {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId  String   @map("category_id")
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @db.Timestamptz(6) @default(now()) @map("created_at")

  @@unique([tenantId, productId, categoryId])
  @@index([tenantId, productId])
  @@index([tenantId, categoryId])
  @@map("product_categories")
}

model ProductVariant {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId   String        @map("product_id")
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String
  barcode     String?
  price       Decimal       @db.Decimal(12, 2)
  costPrice   Decimal?      @db.Decimal(12, 2) @map("cost_price")
  mrp         Decimal?      @db.Decimal(12, 2)
  status      VariantStatus @default(DRAFT)
  createdAt   DateTime      @db.Timestamptz(6) @default(now()) @map("created_at")
  updatedAt   DateTime      @db.Timestamptz(6) @updatedAt @map("updated_at")
  deletedAt   DateTime?     @db.Timestamptz(6) @map("deleted_at")

  attributes        ProductVariantAttribute[]
  images            ProductImage[]
  inventory         Inventory[]
  warehouseInventory WarehouseInventory[]
  orderItems        OrderItem[]
