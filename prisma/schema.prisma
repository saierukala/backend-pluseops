model Customer {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email         String
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  phone         String?
  metadata      Json     @default("{}")
  // Phase 38: CONSUMER or BUSINESS (registered for GST)
  customerType  String   @default("CONSUMER") @map("customer_type")
  companyName   String?  @map("company_name")
  gstin         String?  @db.VarChar(15)
  pan           String?  @db.VarChar(10)
  stateCode     String?  @db.VarChar(2) @map("state_code")
  // Phase 32: storefront account (per tenant). Null until the shopper sets a password via the emailed link.
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @db.Timestamptz(6) @map("email_verified_at")
  lastLoginAt     DateTime? @db.Timestamptz(6) @map("last_login_at")
  createdAt     DateTime @db.Timestamptz(6) @default(now()) @map("created_at")
  updatedAt     DateTime @db.Timestamptz(6) @updatedAt @map("updated_at")
  deletedAt     DateTime? @db.Timestamptz(6) @map("deleted_at")

  orders        Order[]
  addresses     CustomerAddress[]
  sessions      CustomerSession[]
  tokens        CustomerToken[]
  cartItems     CartItem[]

  // Unique per tenant among non-deleted customers only — partial index "customers_tenant_id_email_active_key"
  // (migration 20261024_phase34_data_integrity), so a soft-deleted customer's email can be used again.
  @@index([tenantId, email])
  @@index([tenantId, createdAt])
  @@map("customers")
}

// Storefront login session; the refresh token is "<id>.<secret>" and only its hash is stored (rotated on refresh).
model CustomerSession {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId       String    @map("customer_id")
